---
import type { CollectionEntry } from 'astro:content';

// Level 3 under a section heading (Home), 2 when the list is the page's main content (Work).
const { items, level = 3 } = Astro.props as { items: CollectionEntry<'work'>[]; level?: 2 | 3 };
const Title = level === 2 ? 'h2' : 'h3';
---

<ul class="cases">
  {items.map(({ id, data }) => (
    <li data-reveal>
      <a class="case" href={`/work/${id}`}>
        <div class="fig">
          <strong>{data.figure}</strong>
          <span>{data.figureLabel}</span>
        </div>
        <div class="body">
          <Title class="title">{data.title}</Title>
          <p>{data.outcome}</p>
          <p class="tags">{data.company} · {data.year} · {data.stack.join(', ')}</p>
        </div>
      </a>
    </li>
  ))}
</ul>
