---
import type { CollectionEntry } from 'astro:content';

const { items } = Astro.props as { items: CollectionEntry<'work'>[] };
---

<ul class="cases">
  {items.map(({ id, data }) => (
    <li data-reveal>
      <a class="case" href={`/work/${id}`}>
        <div class="fig">
          <strong>{data.figure}</strong>
          <span>{data.figureLabel}</span>
        </div>
        <div class="body">
          <h3>{data.title}</h3>
          <p>{data.outcome}</p>
          <p class="tags">{data.company} · {data.year} · {data.stack.join(', ')}</p>
        </div>
      </a>
    </li>
  ))}
</ul>
