---
import type { CollectionEntry } from 'astro:content';

const { items } = Astro.props as { items: CollectionEntry<'writing'>[] };
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<ul class="rows writing">
  {items.map(({ id, data }) => (
    <li data-reveal>
      <span class="when">
        <time datetime={data.date.toISOString()}>{fmt(data.date)}</time>
        <span class="topic">{data.pillar}{data.type === 'note' && ' · Note'}</span>
      </span>
      <span class="what"><a href={`/writing/${id}`}>{data.title}</a></span>
      <p class="sub">{data.summary}</p>
    </li>
  ))}
</ul>
