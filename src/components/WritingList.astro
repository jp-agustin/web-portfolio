---
import type { CollectionEntry } from 'astro:content';

const { items } = Astro.props as { items: CollectionEntry<'writing'>[] };
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<ul class="rows">
  {items.map(({ id, data }) => (
    <li data-reveal>
      <time class="when" datetime={data.date.toISOString()}>{fmt(data.date)}</time>
      <span class="what"><a href={`/writing/${id}`}>{data.title}</a></span>
      <p class="sub">{data.pillar}{data.type === 'note' && ' · Note'} · {data.summary}</p>
    </li>
  ))}
</ul>
