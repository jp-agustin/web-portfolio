---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import WritingList from '../components/WritingList.astro';
import { HISTORY } from '../site';
import { getWork, getWriting } from '../content';

const work = (await getWork()).filter((w) => w.data.featured);
const writing = (await getWriting()).slice(0, 3);
---

<Base>
  <h1>I'm John Patrick, a senior full-stack engineer. I build production systems and lead the teams around them.</h1>
  <p class="muted">
    Go · React · TypeScript. 8+ years, most recently at Ninja Van and Ailytics. Below is some of the work and what I
    learned from it.
  </p>

  <h2>Selected work</h2>
  <WorkList items={work} />

  <h2>History</h2>
  <dl class="history">
    {HISTORY.map((h) => (
      <div>
        <dt>{h.years}</dt>
        <dd>{h.company} · {h.role}</dd>
      </div>
    ))}
  </dl>

  {writing.length > 0 && (
    <>
      <h2>Recent writing</h2>
      <WritingList items={writing} />
      <p><a href="/writing">All writing</a></p>
    </>
  )}
</Base>
