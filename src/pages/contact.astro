---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import CopyEmail from '../components/CopyEmail.astro';
---

<Base title="Contact" description="How to reach John Patrick Agustin." footer={false}>
  <section class="page-head wrap grid">
    <h1 data-reveal>Let's talk</h1>
    <p class="lead" data-reveal>
      Tell me a bit about what you're working on: the problem, the team, the timeline. A short note is plenty.
    </p>
    <!-- Before the aside, so phones reach the email first -->
    <div class="reach" data-reveal>
      <p><CopyEmail class="email" /></p>
      <p class="copy-note" aria-hidden="true"><span class="touch">Tap</span><span class="pointer">Click</span> the address to copy it</p>
      <p class="linkedin"><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" data-umami-event="LinkedIn" data-umami-event-from="contact">LinkedIn →</a></p>
    </div>
    <aside data-reveal>
      <p class="dot">Available now</p>
      <p>For part-time, contract, and full-time work.</p>
      <p>Based in the Philippines, {SITE.timezone}</p>
    </aside>
  </section>
</Base>

<style>
  @media (min-width: 52rem) { .page-head aside { grid-row: 1 / span 3; } }
  .reach { margin-top: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .reach p { margin: 0; }
  .reach .linkedin { margin-top: 1.5rem; font-size: var(--step-lead); }
  /* Only once the script has made the address copy; otherwise it's a plain mailto: link */
  .reach .copy-note { display: none; margin-top: 0.5rem; color: var(--muted); font-size: var(--step-small); }
  .reach:has(.ready) .copy-note { display: block; }
  .copy-note .touch { display: none; }
  @media (hover: none) {
    .copy-note .touch { display: inline; }
    .copy-note .pointer { display: none; }
  }
  /* The note replaces the hover tooltip here */
  :global(.email .hint) { display: none !important; }
  :global(.email .address) {
    font-size: clamp(1.375rem, 0.5rem + 3.2vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    overflow-wrap: anywhere;
  }
</style>
