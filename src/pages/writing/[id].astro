---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWriting } from '../../content';

export async function getStaticPaths() {
  return (await getWriting()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={data.title} description={data.summary} type="article">
  <article>
    <header class="page-head wrap grid">
      <h1 class="long" data-reveal>{data.title}</h1>
      <p class="lead" data-reveal>{data.summary}</p>
      <aside data-reveal>
        <p class="dot">{data.pillar}</p>
        <p>
          <time datetime={data.date.toISOString()}>
            {data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </p>
      </aside>
    </header>
    <div class="wrap grid">
      <div class="prose measure body-col" data-reveal><Content /></div>
    </div>
  </article>
  <nav class="wrap band" aria-label="Writing">
    <a class="next" href="/writing"><span>Keep reading</span><strong>All writing →</strong></a>
  </nav>
</Base>
