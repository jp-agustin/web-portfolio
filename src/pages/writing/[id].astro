---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { getWriting } from '../../content';

export async function getStaticPaths() {
  const writing = await getWriting();
  return writing.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: writing[i + 1] ?? writing[0] } }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
---

<Base title={data.title} description={data.summary} type="article">
  <article>
    <header class="page-head wrap grid">
      <h1 class="long" data-reveal>{data.title}</h1>
      <p class="lead" data-reveal>{data.summary}</p>
      <aside data-reveal>
        <p>{data.pillar}</p>
        <p>
          <time datetime={data.date.toISOString()}>
            {data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          {' · '}{minutes} min read
        </p>
      </aside>
    </header>
    <div class="wrap grid">
      <Toc headings={headings} />
      <div class="prose measure body-col" data-reveal><Content /></div>
    </div>
  </article>
  <nav class="wrap band next-row" aria-label="More writing">
    {next.id !== entry.id && (
      <a class="next" href={`/writing/${next.id}`}><span>Next {next.data.type}</span><strong>{next.data.title} →</strong></a>
    )}
    <a class="all" href="/writing">All writing</a>
  </nav>
</Base>
