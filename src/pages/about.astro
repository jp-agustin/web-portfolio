---
import Base from '../layouts/Base.astro';
import { SITE, WAYS } from '../site';

const stack = [
  { level: 'Production-deep', items: 'Go, Node.js, React, TypeScript, Kafka, Redis, MySQL/TiDB, Docker' },
  { level: 'Comfortable', items: 'Python, PostgreSQL, Kubernetes, CI/CD, Flutter, YOLO/CUDA' },
  { level: 'AI tools', items: 'Claude, Cursor, MCP' },
];
const principles = [
  { title: 'Hands-on, even when leading', text: "I write code every sprint and review a lot. It's how I stay close to the work." },
  { title: 'Plan before building', text: 'Time spent understanding the problem saves more time later, for people and for AI tools.' },
  { title: 'Targeted changes over rewrites', text: 'If a critical system works, I fix where it hurts instead of starting over.' },
  { title: 'Trust in remote teams', text: "Most of my teams have been spread across countries. Trust is the default, not something people have to earn first." },
  { title: 'Grow people through real ownership', text: 'Chances to lead, to share, and time to explore.' },
];
---

<Base title="About" description="About John Patrick Agustin, senior full-stack engineer and former Engineering Manager.">
  <section class="page-head wrap grid">
    <h1 data-reveal>About</h1>
    <p class="lead" data-reveal>Senior full-stack engineer with 8+ years of shipping production systems in Go, React and TypeScript.</p>
    <aside data-reveal>
      <p class="dot">Available now</p>
      <p>Philippines (GMT+8)</p>
      <p>Go · React · TypeScript</p>
    </aside>
  </section>

  <section class="wrap grid">
    <div class="prose measure body-col" data-reveal>
      <p>
        I started in 5G R&amp;D at Nokia, built software in Melbourne, then led a drone data platform in Singapore. At
        Ninja Van I joined as a founding engineer on internal tools used across 1,000+ warehouses, and grew into
        Engineering Manager of the platforms team: chat and notification systems handling hundreds of millions of events a
        day, with a team across Singapore and India. Along the way I cut notification costs by over 60%, tripled Kafka
        throughput at peak, and mentored three engineers into senior roles.
      </p>
      <p>
        More recently I led frontend at an AI startup and set up AI-assisted development practices that actually stuck. I
        also built an on-prem computer vision platform for a freelance client.
      </p>
      <p>I'm hands-on first: I write the code, and when needed I lead the team around it.</p>
    </div>
  </section>

  <section class="band wrap grid split">
    <h2 data-reveal>How I work</h2>
    <ul class="rows stacked content">
      {principles.map((p) => (
        <li data-reveal>
          <span class="what">{p.title}</span>
          <p class="sub">{p.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="f-sage band">
    <div class="wrap grid split">
      <h2 data-reveal>Ways to work together</h2>
      <div class="content">
        <ul class="rows stacked">
          {WAYS.map((w) => (
            <li data-reveal>
              <span class="what">{w.title}</span>
              <p class="sub">{w.text}</p>
            </li>
          ))}
        </ul>
        <p data-reveal>
          Hourly or monthly contracts, part-time retainers, fixed-scope projects, or full-time contracts. I'm also open to
          the right full-time role. Based in the Philippines, {SITE.timezone}
          <a href="/contact">Get in touch →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="band wrap grid split">
    <h2 data-reveal>Stack</h2>
    <ul class="rows content">
      {stack.map((s) => (
        <li data-reveal>
          <span class="when">{s.level}</span>
          <span class="what">{s.items}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap grid split">
    <h2 data-reveal>Outside work</h2>
    <div class="content">
      <p class="lead" data-reveal>I'm launching a food product business and building apps of my own. More on both here soon.</p>
      <p class="muted" data-reveal>BS Computer Engineering, University of the Philippines Diliman</p>
    </div>
  </section>
</Base>
