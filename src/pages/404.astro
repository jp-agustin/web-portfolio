---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="page-head wrap grid">
    <h1>Page not found</h1>
    <p class="lead">This page doesn't exist, or it moved.</p>
  </section>
  <nav class="wrap pb next-row" aria-label="Where to go instead">
    <a class="next" href="/"><span>Start again</span><strong>Home →</strong></a>
    <a class="all" href="/work">Work</a>
  </nav>
</Base>
