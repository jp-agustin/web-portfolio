---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWork } from '../../content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: work[i + 1] ?? work[0] } }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
// The headline number lives in the figure, so the page lead leads with it.
const lead = `${data.figure} ${data.figureLabel}. ${data.outcome}.`;
---

<Base title={data.title} description={lead} type="article">
  <article>
    <header class="page-head wrap grid">
      <h1 class="long" data-reveal>{data.title}</h1>
      <p class="lead" data-reveal>{lead}</p>
    </header>
    <section class="facts f-sand" aria-label="Summary">
      <dl class="summary wrap">
        <div><dt>Company</dt><dd>{data.company}</dd></div>
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        <div><dt>Team</dt><dd>{data.team}</dd></div>
        <div><dt>Stack</dt><dd>{data.stack.join(', ')}</dd></div>
        <div><dt>When</dt><dd>{data.year} · {data.duration}</dd></div>
      </dl>
    </section>
    <div class="band wrap grid">
      <nav class="toc" aria-label="On this page">
        <ul>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
      <div class="prose measure body-col" data-reveal><Content /></div>
    </div>
  </article>
  <nav class="wrap next-row" aria-label="More case studies">
    {next.id !== entry.id && (
      <a class="next" href={`/work/${next.id}`}><span>Next case study</span><strong>{next.data.title} →</strong></a>
    )}
    <a class="all" href="/work">All work</a>
  </nav>
</Base>
