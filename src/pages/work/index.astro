---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import { getWork } from '../../content';

const work = await getWork();
---

<Base title="Work" description="Case studies from my work in engineering and engineering leadership.">
  <section class="page-head wrap grid">
    <h1 data-reveal>Work</h1>
    <p class="lead" data-reveal>Projects I built and led: the problem, the options, the decision, and what I'd do differently.</p>
    <aside data-reveal><strong>{work.length}</strong>case studies</aside>
  </section>
  <section class="wrap">
    <WorkList items={work} />
  </section>
</Base>
